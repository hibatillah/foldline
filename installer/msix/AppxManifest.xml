<?xml version="1.0" encoding="utf-8"?>
<!-- Template: scripts/build-msix.sh replaces {{VERSION}} with the workspace version as four parts (0.5.0 gives 0.5.0.0). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap7="http://schemas.microsoft.com/appx/manifest/uap/windows10/7"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap7 desktop rescap">

  <!-- Identity values from Partner Center (Product identity). -->
  <Identity
    Name="Hibatillah.foldline"
    Publisher="CN=98DF2263-B041-4E7A-A75D-06BAFF928671"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Foldline</DisplayName>
    <PublisherDisplayName>Hibatillah</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- notch-settings.exe ships beside notch.exe as a plain file: the tray and the header gear start it, as in the Inno install. -->
    <Application Id="Notch" Executable="notch.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Foldline"
        Description="A notch at the top of the screen for media, calendar, timer, weather and more."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Foldline" />
      </uap:VisualElements>
      <Extensions>
        <!-- Off until the user turns on Start with Windows; the settings window then calls StartupTask, not the Run key. -->
        <desktop:Extension Category="windows.startupTask" Executable="notch.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="NotchStartup" Enabled="false" DisplayName="Foldline" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Full trust needs no capability for the internet or a loopback listener; this one states intent in the Store listing. -->
    <Capability Name="internetClient" />
    <uap7:Capability Name="globalMediaControl" />
    <uap3:Capability Name="userNotificationListener" />
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="location" />
  </Capabilities>
</Package>
