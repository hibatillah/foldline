{
	"name": "website",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.0"
	},
	"scripts": {
		"dev": "bun --bun next dev",
		"build": "bun --bun next build",
		"start": "bun --bun next start",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "bun fmt --no-script",
		"format:check": "bun fmt --check --no-script",
		"prepare": "cd .. && husky website/.husky || true"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"lucide-react": "^1.78.0",
		"motion": "^14.14.0",
		"next": "16.4.6",
		"next-intl": "^4.16.0",
		"next-themes": "^0.4.6",
		"posthog-js": "^1.454.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"shadcn": "^4.23.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/bun": "^1.4.5",
		"@types/node": "^26",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"oxlint": "^1.95.0",
		"oxlint-tsgolint": "^7.0.2008",
		"tailwindcss": "^4",
		"typescript": "^7"
	}
}
